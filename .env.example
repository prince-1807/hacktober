# Campus_CP Server-Only Environment Configuration
# STRICT SECURITY: Do NOT prefix with NEXT_PUBLIC_ to prevent leaking secrets to browser runtime.

# PostgreSQL Connection String (used by Prisma ORM)
DATABASE_URL="postgresql://campus_cp_admin:hacktober_secret@localhost:5432/campus_cp_db?schema=public"

# Redis Cache Connection String (used by ioredis for SWR caching)
REDIS_URL="redis://localhost:6379"

# Token for authenticating admin ratings sync triggers
SYNC_TOKEN="bit_sindri_hacktober_2026_secure_sync_token"

# Environment Mode: 'development' | 'production' | 'test'
NODE_ENV="development"

# Scraping Mode: 'false' uses deterministic simulation + seed snapshot fallback to prevent 429 rate-limiting
ENABLE_LIVE_SCRAPING="false"
